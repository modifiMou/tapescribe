<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- 模板：desktop/install-agent.sh 替换 __TOKEN__ 后写入 ~/Library/LaunchAgents。 -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.kbrain.asrworkbench.watchdog</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>__WATCHDOG__</string>
  </array>

  <key>StartInterval</key>
  <integer>30</integer>
  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/asrWorkbench-watchdog.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/asrWorkbench-watchdog.log</string>
</dict>
</plist>
